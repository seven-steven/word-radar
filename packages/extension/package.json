  },
  "dependencies": {
    "@word-radar/core": "workspace:*",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@playwright/test": "^1.50.0",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  }
}