{
  "name": "@word-radar/extension",
  "version": "0.1.0",
  "description": "WordRadar Chrome/Edge MV3 扩展（主形态）",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
