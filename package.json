{
  "name": "word-radar",
  "version": "0.1.0",
  "private": true,
  "description": "单词雷达 - 一键提取网页英文生词并推送到不背单词生词本",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "clean": "pnpm -r --filter=./packages/* clean",
    "package": "node scripts/package.mjs",
    "e2e": "node scripts/e2e/run-e2e.mjs",
    "screenshot": "node scripts/e2e/run-screenshots.mjs",
    "verify:changelog": "node scripts/verify-changelog.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:zip": "node scripts/verify-zip.mjs",
    "verify:claims": "node scripts/verify-claims.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}